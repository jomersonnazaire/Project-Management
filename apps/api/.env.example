# Copy to apps/api/.env for local development. Never commit real values.
NODE_ENV=development
PORT=4000

# MongoDB 7 (Atlas in production). For local dev run `npm run dev:db` and paste the URI it prints.
MONGODB_URI=mongodb://127.0.0.1:27027/?replicaSet=rs0
MONGODB_DB_NAME=xc8_pm

# Public URL of the web app (used to build invite / password-setup links)
WEB_APP_URL=http://localhost:5173
# Allowed browser origins, comma-separated; `*` allowed inside a host label for Vercel previews
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session cookie. Local dev over http: COOKIE_SECURE=false, COOKIE_SAMESITE=lax.
# Production cross-site (web on *.vercel.app calling *.azurewebsites.net directly): COOKIE_SAMESITE=none, COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Account lockout (FR-AUTH-07) and per-IP sign-in rate limit (NFR-05)
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# Single-use link lifetimes: first-time invites and Admin-issued password resets
INVITE_TTL_HOURS=72
RESET_TTL_HOURS=24

# Trusted proxies that append to X-Forwarded-For on the direct path (0 local, 1 Azure App Service)
TRUST_PROXY_HOPS=0
# Shared secret sent by the Vercel /api middleware with the visitor IP (32+ chars; same value on Vercel)
EDGE_PROXY_SECRET=
# IPv4 addresses in the same /N share one sign-in rate-limit bucket
AUTH_RATE_LIMIT_IPV4_PREFIX=24
LOG_LEVEL=info

# Seed script only (npm run seed). Must meet the password policy (8+ chars, a number, a symbol).
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
SEED_RESET_PASSWORDS=false
