{
  "name": "@xc8/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Xceler8 Implementation Tracker REST API (Express + TypeScript, Node 22)",
  "engines": {
    "node": ">=22 <23"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "seed:holidays": "tsx --env-file-if-exists=.env scripts/seed-holidays.ts",
    "seed:qa-project": "tsx --env-file-if-exists=.env scripts/seed-qa-project.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.34.0",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "@xc8/shared": "*",
    "mongodb-memory-server": "^10.2.0",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.24"
    }
  }
}
