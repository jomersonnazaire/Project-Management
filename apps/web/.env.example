# Copy to apps/web/.env.local for local development. Only VITE_* variables reach the browser,
# so never put secrets here.

# Base URL of the API (no trailing slash, without /api/v1).
# Leave empty to call the same origin (/api/v1): Vite proxies it locally and vercel.json
# rewrites it to Azure in production (first-party cookies, recommended).
# Or set the API URL to call it cross-site, e.g. https://xc8-projectmgmt-api-tc3w.azurewebsites.net
# (then the API needs COOKIE_SAMESITE=none and this site's origin in CORS_ORIGINS).
VITE_API_BASE_URL=

# Local dev only: where Vite proxies /api (default http://localhost:4000)
VITE_DEV_API_PROXY=http://localhost:4000
